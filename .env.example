# Copy to .env for local runs. In production these live in the Render / Vercel dashboards.
# NEVER commit the real .env.

# --- LiveKit (required, both services) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- LLM (required by the agent worker) ---
# Cloudflare Workers AI chain primary, gemini/groq chain fallback
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
GOOGLE_API_KEY=
GROQ_API_KEY=

# --- Self-hosted Qwen lead (optional; Kaggle QWEN_SELFHOST notebook) ---
# When both are set, this OpenAI-compatible endpoint leads the LLM chain;
# the notebook reprints a new URL every session, so update and restart.
# OLLAMA_BASE_URL=https://your-tunnel.trycloudflare.com/v1
# OLLAMA_CLOUD_API_KEY=mcq-viva-demo
# OLLAMA_LLM_MODEL=qwen3-30b

# --- Speech STT/TTS (required by the agent worker) ---
# groq whisper (primary STT) + sarvam realtime (fallback STT) + sarvam bulbul (TTS)
SARVAM_API_KEY=

# --- Self-hosted kokoro TTS sidecar (optional) ---
# TTS_PROVIDER=kokoro routes TTS to the kokoro-tts sidecar.
# KOKORO_TTS_URL defaults to http://localhost:8000.
# KOKORO_VARIANT (sidecar process env) selects the model: "stock" (hexgrad
# Kokoro-82M) or "goonj" (BH-Builds Hindi/Indian-English fine-tune). The
# agent's KOKORO_TTS_VARIANT must match it; defaults to "stock".
# TTS_PROVIDER=kokoro
# KOKORO_TTS_VARIANT=stock
# KOKORO_TTS_VOICE=

# --- Avatar ---
# Which avatar provider to use: "simli", "tavus", or "none" (voice-only).
# Left unset, the agent picks automatically from whichever credentials below are
# present (simli wins if both are set). Set it explicitly to force a choice.
AVATAR_PROVIDER=

# --- Simli avatar (optional) ---
SIMLI_API_KEY=
SIMLI_AVATAR_ID=
# SIMLI_JOIN_TIMEOUT=15
# SIMLI_MAX_SESSION_LENGTH=1800
# SIMLI_MAX_IDLE_TIME=300

# --- Tavus avatar (optional; photoreal, not 2D) ---
# Get a free key at https://tavus.io (20-25 free CVI minutes).
# The stock "Lucy - Home" face is used when TAVUS_FACE_ID is unset.
TAVUS_API_KEY=
# TAVUS_FACE_ID=
# TAVUS_PAL_ID=
# TAVUS_JOIN_TIMEOUT=30

# --- Token server ---
# Required. Shared secret the frontend sends to /token; while unset, /token returns 500 (fails closed). Any value works locally.
APP_PASSWORD=
# Comma-separated browser origins allowed to call /token (e.g. https://your-app.vercel.app).
# Unset = fall back to the same-host check.
TOKEN_ALLOWED_ORIGINS=
# TOKEN_RATE_LIMIT=10
