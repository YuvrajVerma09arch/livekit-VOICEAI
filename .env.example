# Copy to .env for local runs. In production these live in the Render / Vercel dashboards.
# NEVER commit the real .env.

# --- LiveKit (required, both services) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- LLM (required by the agent worker) ---
# gemini chain primary, groq chain fallback
GOOGLE_API_KEY=
GROQ_API_KEY=

# --- Speech STT/TTS (required by the agent worker) ---
# groq whisper (primary STT) + sarvam realtime (fallback STT) + sarvam bulbul (TTS)
SARVAM_API_KEY=

# --- Avatar ---
# Which avatar provider to use: "simli", "tavus", or "none" (voice-only).
# Left unset, the agent picks automatically from whichever credentials below are
# present (simli wins if both are set). Set it explicitly to force a choice.
AVATAR_PROVIDER=

# --- Simli avatar (optional) ---
SIMLI_API_KEY=
SIMLI_AVATAR_ID=
# SIMLI_JOIN_TIMEOUT=15
# SIMLI_MAX_SESSION_LENGTH=1800
# SIMLI_MAX_IDLE_TIME=300

# --- Tavus avatar (optional; photoreal, not 2D) ---
# Get a free key at https://tavus.io (20-25 free CVI minutes).
# The stock "Lucy - Home" face is used when TAVUS_FACE_ID is unset.
TAVUS_API_KEY=
# TAVUS_FACE_ID=
# TAVUS_PAL_ID=
# TAVUS_JOIN_TIMEOUT=30

# --- Token server ---
# Required. Shared secret the frontend sends to /token; while unset, /token returns 500 (fails closed). Any value works locally.
APP_PASSWORD=NIGGAS
# Comma-separated browser origins allowed to call /token (e.g. https://your-app.vercel.app).
# Unset = fall back to the same-host check.
TOKEN_ALLOWED_ORIGINS=
# TOKEN_RATE_LIMIT=10
