# Copy to .env for local runs. In production these live in the Render / Vercel dashboards.
# NEVER commit the real .env.

# --- LiveKit (required) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Speech / LLM (required by base_agent.py) ---
ELEVEN_API_KEY=
GROQ_API_KEY=
# optional: pin a specific ElevenLabs voice
ELEVEN_VOICE_ID=

# --- Simli avatar (optional: agent falls back to voice-only when unset) ---
SIMLI_API_KEY=
SIMLI_AVATAR_ID=
# SIMLI_JOIN_TIMEOUT=15
# SIMLI_MAX_SESSION_LENGTH=1800
# SIMLI_MAX_IDLE_TIME=300

# --- Token server ---
# TOKEN_RATE_LIMIT=10
